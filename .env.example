# Native server port. Docker publishes 8080 by default (see docker-compose.yml).
PORT=2050

# Runtime data directory. Keep this outside version control in production.
DATA_DIR=./data

# Optional: these can also be configured from the in-app Settings screen.
OPENCLAW_URL=http://localhost:18789
OPENCLAW_TOKEN=
OPENCLAW_AGENT_ID=main

# Optional web-push configuration. Leave blank to generate/use local settings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
