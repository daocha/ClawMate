# ---- Server ----
PORT=2050
# Where persistent settings + VAPID keys are stored
DATA_DIR=./data

# ---- OpenClaw connection (can also be set from the in-app Settings screen) ----
# Base URL of your OpenClaw instance, e.g. http://openclaw:3000 or https://claw.example.com
OPENCLAW_URL=
# API token / key for OpenClaw
OPENCLAW_TOKEN=
# Default agent id used when the app has none configured
OPENCLAW_AGENT_ID=

# ---- Web Push (VAPID) ----
# Leave empty and the server will generate a key pair into $DATA_DIR/vapid.json on first boot
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
